<RCC>
    <qresource prefix="/wsicon">
        <file alias="wsiconcap16.png">cap-16.png</file>
        <file alias="wsiconcap32.png">cap-32.png</file>
        <file alias="wsiconcap64.png">cap-64.png</file>
        <file alias="wsiconcap128.png">cap-128.png</file>
        <file alias="wsiconcap256.png">cap-256.png</file>
        <file alias="wsiconcap512.png">cap-512.png</file>
        <file alias="wsiconcap1024.png">cap-1024.png</file>
    </qresource>
    <qresource prefix="/blehound">
        <file>splash.png</file>
        <file>splash@2x.png</file>
    </qresource>
    <!-- Toolbar capture icons replacing the shark-fin ones. -->
    <qresource prefix="/stock_icons">
        <file alias="16x16/blehound-capture-start.png">toolbar/16x16/blehound-capture-start.png</file>
        <file alias="16x16/blehound-capture-start@2x.png">toolbar/16x16/blehound-capture-start@2x.png</file>
        <file alias="16x16/blehound-capture-start.on.png">toolbar/16x16/blehound-capture-start.on.png</file>
        <file alias="16x16/blehound-capture-start.on@2x.png">toolbar/16x16/blehound-capture-start.on@2x.png</file>
        <file alias="16x16/blehound-capture-restart.png">toolbar/16x16/blehound-capture-restart.png</file>
        <file alias="16x16/blehound-capture-restart@2x.png">toolbar/16x16/blehound-capture-restart@2x.png</file>
        <file alias="24x24/blehound-capture-start.png">toolbar/24x24/blehound-capture-start.png</file>
        <file alias="24x24/blehound-capture-start@2x.png">toolbar/24x24/blehound-capture-start@2x.png</file>
        <file alias="24x24/blehound-capture-start.on.png">toolbar/24x24/blehound-capture-start.on.png</file>
        <file alias="24x24/blehound-capture-start.on@2x.png">toolbar/24x24/blehound-capture-start.on@2x.png</file>
        <file alias="24x24/blehound-capture-restart.png">toolbar/24x24/blehound-capture-restart.png</file>
        <file alias="24x24/blehound-capture-restart@2x.png">toolbar/24x24/blehound-capture-restart@2x.png</file>
    </qresource>
</RCC>
