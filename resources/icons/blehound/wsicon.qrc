        <file alias="wsicon16.png">app-16.png</file>
        <file alias="wsicon24.png">app-24.png</file>
        <file alias="wsicon32.png">app-32.png</file>
        <file alias="wsicon48.png">app-48.png</file>
        <file alias="wsicon64.png">app-64.png</file>
        <file alias="wsicon128.png">app-128.png</file>
        <file alias="wsicon256.png">app-256.png</file>
        <file alias="layers/all.svg">layers/all.svg</file>
        <file alias="layers/all.on.svg">layers/all.on.svg</file>
        <file alias="layers/packets.svg">layers/packets.svg</file>
        <file alias="layers/packets.on.svg">layers/packets.on.svg</file>
        <file alias="layers/link.svg">layers/link.svg</file>
